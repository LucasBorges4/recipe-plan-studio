{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".output/public",
  "functions": {
    ".output/server/index.mjs": {
      "includeFiles": ".output/**"
    }
  },
  "env": {
    "NITRO_PRESET": "vercel"
  }
}
