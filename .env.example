# Backend do Portal de Governança (Grupo Geos)
#
# Copie para `.env` e ajuste conforme o ambiente.
# Nenhuma dessas variáveis é obrigatória em desenvolvimento local:
# sem AUTH_PEPPER, o sistema gera um pepper e o persiste na tabela `meta`
# do banco de dados.

# Caminho do banco SQLite. Padrão: .data/portal.db (resolvido para caminho
# absoluto a partir do diretório de execução; a pasta é criada automaticamente).
# Se o caminho não abrir, tenta-se <cwd>/.data/portal.db e depois /tmp/portal.db.
# Em runtime sem disco gravável (ex.: edge da Lovable), usa-se SQLite em
# memória e os dados reiniciam a cada instância (o payload sinaliza persistent:false).
DATABASE_PATH=.data/portal.db

# Em produção (ex.: VM Oracle) defina 1 para falhar explicitamente caso o banco
# persistente não possa ser aberto, em vez de cair silenciosamente em memória.
STORAGE_REQUIRE_PERSISTENT=


# Pepper global da aplicação (Argon2 keyed hashing). Use um segredo forte e
# estável entre reinicializações. Se omitido, é gerado e persistido no banco.
# Gere com:  openssl rand -base64 32
AUTH_PEPPER=

# Código de convite obrigatório para criar conta em /login (cadastro).
# Se definido, o campo "Código de cadastro" no signup deve coincidir exatamente.
# Sem ele, o cadastro fica aberto (útil só em dev). Gere com: openssl rand -hex 8
REGISTRATION_CODE=
# Alias compatível: INVITE_CODE ou CADASTRO_CODE também são aceitos.

# n8n — Automações por role (porta dedicada 5679)
# N8N_URL: URL interna usada pelo backend para chamar a API n8n (fetch server-side).
# Mantenha 127.0.0.1 se n8n roda na mesma máquina - mais rápido e seguro.
N8N_URL=http://127.0.0.1:5679
# N8N_PUBLIC_URL: URL pública usada no frontend (iframe, links, webhooks).
# Deixe vazio para auto-detecção do IP público via https://api.ipify.org
# ou defina explicitamente: https://SEU_IP_DASH.sslip.io  ou  http://SEU_IP:5679
# Exemplo auto: curl -s https://api.ipify.org ; IP=$(curl -s https://api.ipify.org); echo https://${IP//./-}.sslip.io
N8N_PUBLIC_URL=
N8N_API_KEY=
N8N_ENCRYPTION_KEY=

# Turso / libSQL — Banco persistente para Vercel (SQLite na nuvem, grátis)
# Crie em https://turso.tech → turso db create recipe-plan-studio → turso db show <nome> --url + turso db tokens create <nome>
# Na Vercel: Settings > Environment Variables > adicione TURSO_DATABASE_URL e TURSO_AUTH_TOKEN
# Local: copie para .env e rode npm run dev (vai usar Turso remoto em vez de .data/portal.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Aliases compatíveis: LIBSQL_URL, LIBSQL_AUTH_TOKEN, ou DATABASE_URL=libsql://...
